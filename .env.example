# ==============================================================================
# ENVIRONMENT & RUNTIME SETTINGS
# ==============================================================================
ENV=local                               # Options: local, development, production, ci
PORT=8000

# ==============================================================================
# LLM PROVIDER API KEYS
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ==============================================================================
# LANGSMITH OBSERVABILITY & LLMOPS TRACING
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_your_langsmith_api_key_here
LANGCHAIN_PROJECT=end-to-end-advanced-rag-with-llmops

# ==============================================================================
# DISTRIBUTED CACHE & VECTOR STORAGE
# ==============================================================================
# For host/local execution with mapped Docker ports:
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6333

# For containerized execution inside Docker Compose network (automatically set):
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333

# ==============================================================================
# OPERATIONAL ALERTING & WEBHOOKS
# ==============================================================================
# Optional: External webhook endpoint for critical anomaly alerts (Slack, Discord, Teams)
ALERT_WEBHOOK_URL=

# ==============================================================================
# DOCKER HUB REGISTRY PUBLISHING (Used in CI/CD & GitHub Actions)
# ==============================================================================
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_personal_access_token
DOCKERHUB_REPO=rag-app
